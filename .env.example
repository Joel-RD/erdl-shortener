# Entorno
NODE_ENV=development

# Servidor
PORT=3000
# Origen público con el que se construyen los enlaces cortos.
BASE_URL=http://localhost:3000
# 0 en local; 1 detrás del proxy de Render.
TRUST_PROXY=0

# Token de administración (takedown/blocklist). Mínimo 16 caracteres.
# Genera uno con: openssl rand -hex 32
# Déjalo vacío en el ejemplo para que el arranque falle hasta configurarlo.
ADMIN_TOKEN=

# Secreto HMAC para hashear IPs (límites, cuotas y dedupe). Mínimo 16.
# Genera uno distinto con: openssl rand -hex 32
# Mantenlo estable: si rota, los hashes ya guardados dejan de coincidir.
IP_HASH_SECRET=

# Niveles: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Base de datos (Fase 1)
# Dev/tests: SQLite local con WAL. Prod: libsql://... (Turso).
DATABASE_URL=file:local.db
# Solo para Turso remoto; vacío en local.
DATABASE_AUTH_TOKEN=

# Correo visible en el pie para reportar abuso. Opcional en local.
ABUSE_CONTACT_EMAIL=
